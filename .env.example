# PostgreSQL（同服务器另一个 compose 项目，通过宿主机端口访问）
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=algo
DB_USER=algo
DB_PASSWORD=your-password

# TDengine REST API（同上，端口 6041）
TD_HOST=host.docker.internal
TD_PORT=6041
TD_USER=root
TD_PASSWORD=taosdata
TD_DATABASE=hiccpet_device
TD_SUPERTABLE=imu_data

# 服务配置（可选，默认值已够用）
LOG_LEVEL=info
FETCH_INTERVAL_MIN=15
