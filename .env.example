# PostgreSQL（同服务器另一个 compose 项目，通过宿主机端口访问）
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=pet_collar
DB_USER=postgres
DB_PASSWORD=123456

# TDengine REST API（同上，端口 6041）
TD_HOST=host.docker.internal
TD_PORT=6041
TD_USER=root
TD_PASSWORD=taosdata
TD_DATABASE=pet_collar_raw
TD_SUPERTABLE=imu_raw

# 服务配置（可选，默认值已够用）
LOG_LEVEL=info
FETCH_INTERVAL_MIN=15


# 容器运行用户（保持日志文件归属当前用户，无需 sudo 删除）
# 值通过 id -u 和 id -g 获取，cp .env.example .env 后按实际填写
UID=1000
GID=1000
TZ_OFFSET_HOURS=8
