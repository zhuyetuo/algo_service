# Copy to .env and fill in real values
DB_HOST=postgres
DB_PORT=5432
DB_NAME=algo
DB_USER=algo
DB_PASSWORD=change_me

LOG_LEVEL=info

# IMU & inference
IMU_SAMPLE_RATE=50        # Hz
WINDOW_SECONDS=3          # classification sliding window size
WINDOW_OVERLAP=0.5        # 50% overlap between windows

# How often to fetch IMU data and run inference (minutes)
FETCH_INTERVAL_MIN=15     # change to 60 without redeploying
