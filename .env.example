# MySQL（algo 服务自身数据库）
DB_HOST=192.168.33.253
DB_PORT=30100
DB_NAME=algo
DB_USER=root
DB_PASSWORD=Hicc-pet-mysql-2026

# 业务数据库（设备绑定、用户信息来源）
BIZ_SCHEMA=hiccpet_petos

# TDengine REST API（端口 6041）
TD_HOST=192.168.33.253
TD_PORT=6041
TD_USER=root
TD_PASSWORD=taosdata
TD_DATABASE=hiccpet_device
TD_SUPERTABLE=imu_data

# 服务配置（可选，默认值已够用）
LOG_LEVEL=info
FETCH_INTERVAL_SEC=15

# label_infra 对接（/api/v1/label/infer、/train）
# 宿主机上 NAS 数据根目录，跟 label_infra 后端的 NAS_ROOT 指向同一个目录；容器内固定挂到 /nas
NAS_HOST_PATH=/home/toky/ai_data
# 训练完成后回调 label_infra 的地址，留空则只支持 label_infra 轮询
LABEL_INFRA_CALLBACK_URL=
